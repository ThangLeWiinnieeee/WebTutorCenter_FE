# Chỉ dùng khi chạy development. Production luôn gọi /api cùng origin Vercel;
# vercel.json reverse-proxy sang Render để refresh cookie vẫn là first-party.
VITE_API_BASE_URL=http://localhost:5002/api

# Socket.IO production kết nối thẳng Render bằng access token RAM.
# Code đang fallback về URL trong vercel.json; nên đặt biến này trên Vercel để dễ đổi host sau này.
# Prod: https://webtutor-api.onrender.com
VITE_SOCKET_URL=

# Google OAuth Client ID (giống GOOGLE_CLIENT_ID bên backend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
